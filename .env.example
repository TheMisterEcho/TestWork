# --- Конфигурация LLM ---
# Ключ API (для OpenRouter или OpenAI)
OPENAI_API_KEY=your_api_key_here

# Базовый URL. Оставьте пустым для OpenAI, 
# или укажите https://openrouter.ai/api/v1 для OpenRouter
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Модель. Для бесплатного тестирования через OpenRouter используйте:
# openrouter/free
# Или конкретную модель, например: gpt-4o-mini
LLM_MODEL=openrouter/free

# --- База данных ---
# Путь к файлу SQLite (по умолчанию suppliers.db в корне проекта)
SUPPLIERS_DB=suppliers.db